{
  "name": "filialconnect-devtools",
  "version": "1.4.0",
  "private": true,
  "description": "Dev/CI tooling manifest only (htmlhint, linkinator, lighthouse-ci). The site is plain HTML/CSS/JS served statically; this file exists so the checkers and their transitive dependencies are pinned and Dependabot can bump them.",
  "scripts": {
    "lint:html": "htmlhint \"index.html\" \"404.html\" \"pages/*.html\"",
    "links": "linkinator . --recurse --check-fragments --check-external --skip \"https://lxh113377.github.io/filialconnect.*\"",
    "lhci": "lhci autorun --config=lighthouserc.json"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "cheerio": "1.2.0",
    "htmlhint": "1.9.2",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "linkinator": "8.1.0",
    "pagefind": "1.5.2",
    "workbox-build": "7.4.1",
    "xmlbuilder2": "3.1.1"
  },
  "engines": {
    "node": ">=22.19"
  }
}
